# Embedding service: EmbeddingGemma through sentence-transformers on CPU.
# The weights are gated on Hugging Face: pass HF_TOKEN at runtime (or mount
# a populated cache at /home/app/.cache/huggingface) for the first start.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
RUN useradd --create-home --uid 1000 app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --extra model \
    && chown -R app:app /app
ENV PATH="/app/.venv/bin:$PATH" OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
USER app
EXPOSE 8201
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8201/healthz').read()"
CMD ["uvicorn", "asknews.embed.service:app", "--host", "0.0.0.0", "--port", "8201"]

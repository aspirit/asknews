# Embedding service: a sentence-transformers model on CPU, chosen with
# ASKNEWS_EMBED_MODEL. EmbeddingGemma's weights are gated on Hugging Face:
# pass HF_TOKEN at runtime for its first start. multilingual-e5-base is open.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
RUN useradd --create-home --uid 1000 app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# The model cache is a volume; it must exist in the image with the service
# user as owner, or Docker creates it owned by root and downloads fail.
RUN uv sync --locked --no-dev --extra model \
    && mkdir -p /home/app/.cache/huggingface \
    && chown -R app:app /app /home/app
ENV PATH="/app/.venv/bin:$PATH" OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
USER app
EXPOSE 8201
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8201/healthz').read()"
CMD ["uvicorn", "asknews.embed.service:app", "--host", "0.0.0.0", "--port", "8201"]

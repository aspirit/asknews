# Copy to .env and adjust. Values here match docker-compose.yml.
DATABASE_URL=postgresql://asknews:asknews@localhost:5432/asknews

# Used only by the test suite; the database name must end with "_test".
TEST_DATABASE_URL=postgresql://asknews:asknews@localhost:5432/asknews_test

# --- Production (docker-compose.prod.yml) ---
# POSTGRES_PASSWORD=change-me
# ASKNEWS_CLIENT_SALT=change-me-too          # salts the daily client hash used for rate limits
# ANTHROPIC_API_KEY=                          # answers, summaries and briefs
# ASKNEWS_EMBEDDER=remote                     # the embed service; "hash" is a stand-in only
# ASKNEWS_EMBED_MODEL=google/embeddinggemma-300m   # or intfloat/multilingual-e5-base (open weights)
# HF_TOKEN=                                   # first download of EmbeddingGemma (gated)
# ASKNEWS_LLM_MODEL=claude-opus-5-5
# ASKNEWS_SUMMARY_MODEL=claude-sonnet-5-5
# ASKNEWS_DAILY_BUDGET_USD=3
# ASKNEWS_SITE_URL=https://asknews.jp               # canonical and hreflang links
# YOUTUBE_API_KEY=                            # optional: backfill the whole video list
